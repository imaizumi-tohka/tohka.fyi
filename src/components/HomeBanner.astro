---
import { Image } from 'astro:assets'
import GitHubActivityCalendar from '@components/GitHubActivityCalendar.astro'
import type { FrontmatterImage } from '@types'

interface Props {
  avatarImage?: FrontmatterImage
  githubCalendar?: string
}
const { avatarImage, githubCalendar } = Astro.props
---

<div class="my-8">
  <div
    class="flex flex-col sm:flex-row items-center justify-start gap-6 sm:gap-8 max-w-full mb-10"
  >
    {
      avatarImage && (
        <Image
          src={avatarImage.src}
          alt={avatarImage.alt}
          class="rounded-full border-8 border-accent/15 ring-1 ring-accent/25 ring-offset-4 ring-offset-background size-40 sm:size-48 aspect-square"
        />
      )
    }
    <div>
      <div class:list={['home-banner-copy max-w-full prose']}>
        <slot />
      </div>
    </div>
  </div>
  {githubCalendar && <GitHubActivityCalendar username={githubCalendar} />}
</div>

<style>
  /* バナー内は段落の上下マージンを詰めて、行として並べる */
  .home-banner-copy :global(p) {
    margin-block: 0;
  }

  /* 名前を一段大きく、タグラインは控えめに */
  .home-banner-copy :global(p:first-child) {
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.6rem);
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.3;
  }

  .home-banner-copy :global(p + p) {
    margin-block-start: 0.35rem;
    color: var(--theme-muted);
    font-size: 0.95rem;
  }
</style>
