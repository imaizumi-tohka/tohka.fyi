<script is:inline>
  ;(function loadTheme() {
    const root = document.documentElement
    const lightTheme = root.getAttribute('data-light-theme')
    const eveningTheme = root.getAttribute('data-evening-theme')
    const darkTheme = root.getAttribute('data-dark-theme')
    const themeHash = root.getAttribute('data-theme-hash')
    const defaultTheme = root.getAttribute('data-theme') || 'auto'
    if (!lightTheme || !darkTheme || !themeHash) {
      throw new Error('Theme attributes are required.')
    }

    const storedHash = localStorage.getItem('data-theme-hash')
    if (!localStorage.getItem('data-theme') || storedHash !== themeHash) {
      // 初回、またはテーマ構成が変わったときは既定値に戻す
      localStorage.setItem('data-theme', defaultTheme)
      localStorage.setItem('data-theme-hash', themeHash)
    }

    // 自動モード: OS の外観設定を最優先する。
    // - OS がダーク → 夜
    // - OS がライト → 16〜19時だけ夕方、それ以外は日中
    const resolveAuto = () => {
      if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        return darkTheme
      }
      if (!eveningTheme) return lightTheme
      const hour = new Date().getHours()
      return hour >= 16 && hour < 19 ? eveningTheme : lightTheme
    }

    const applyTheme = () => {
      const stored = localStorage.getItem('data-theme') || 'auto'
      root.setAttribute('data-theme', stored === 'auto' ? resolveAuto() : stored)
    }

    applyTheme()
    window.__applyTheme = applyTheme
    // 時刻の境界と OS 設定の変化を取りこぼさないよう1分ごとに見直す
    setInterval(applyTheme, 60 * 1000)
    window
      .matchMedia('(prefers-color-scheme: dark)')
      .addEventListener('change', applyTheme)
  })()
</script>
