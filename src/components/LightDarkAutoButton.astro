---
import { Icon } from 'astro-icon/components'
import siteConfig from '../site.config'
const paletteNames = siteConfig.themes.palette?.map((entry) => entry.name)
const included = (
  paletteNames?.length ? paletteNames : (siteConfig.themes.include as string[])
) as string[]
const hasEvening = included.length >= 3
const lightTheme = included[0]
const eveningTheme = hasEvening ? included[1] : undefined
const darkTheme = hasEvening ? included[2] : included[1]
---

<button
  id="theme-change-button"
  class="block ml-auto rounded-md p-1 transition-colors hover:bg-accent/10"
  aria-label="テーマの切り替え"
  data-light={lightTheme}
  data-evening={eveningTheme}
  data-dark={darkTheme}
>
  <Icon name="sun" id="icon-light" class="hidden size-6 text-[var(--theme-accent)]" />
  <Icon
    name="sun-moon"
    id="icon-evening"
    class="hidden size-6 text-[var(--theme-accent)]"
  />
  <Icon name="moon" id="icon-dark" class="hidden size-6 text-[var(--theme-accent)]" />
  <Icon name="clock" id="icon-auto" class="hidden size-6 text-[var(--theme-accent)]" />
</button>

<script>
  const themeButton = document.getElementById('theme-change-button')
  const lightThemeId = themeButton?.getAttribute('data-light')
  const eveningThemeId = themeButton?.getAttribute('data-evening')
  const darkThemeId = themeButton?.getAttribute('data-dark')
  const icons = {
    light: themeButton?.querySelector('#icon-light'),
    evening: themeButton?.querySelector('#icon-evening'),
    dark: themeButton?.querySelector('#icon-dark'),
    auto: themeButton?.querySelector('#icon-auto'),
  }
  const order = [lightThemeId, eveningThemeId, darkThemeId, 'auto'].filter(
    (theme): theme is string => !!theme,
  )
  const updateIcons = (theme: string) => {
    const key =
      theme === lightThemeId
        ? 'light'
        : theme === eveningThemeId
          ? 'evening'
          : theme === darkThemeId
            ? 'dark'
            : 'auto'
    for (const [name, el] of Object.entries(icons)) {
      el?.classList.toggle('hidden', name !== key)
    }
  }
  updateIcons(localStorage.getItem('data-theme') || 'auto')
  themeButton?.addEventListener('click', () => {
    // 日中 → 夕方 → 夜 → 自動 の順に循環する
    const current = localStorage.getItem('data-theme') || 'auto'
    const index = order.indexOf(current)
    const next = order[(index + 1) % order.length]
    if (!next) return
    localStorage.setItem('data-theme', next)
    updateIcons(next)
    if (next === 'auto') {
      ;(window as any).__applyTheme?.()
    } else {
      document.documentElement.setAttribute('data-theme', next)
    }
  })
</script>
